func prueba_for:
total = 0
i = 0
for4:
t5 = i < 3
ifFalse t5 goto endfor6
t6 = total + i
total = t6
i = i + 1
goto for4
endfor6:
return total
end func prueba_for
func main:
t7 = call prueba_constantes, 0
a = t7
t8 = call prueba_branch, 0
