func sum:
param a
param b
t1 = a + b
return t1
end func sum
func square:
param x
t2 = x * x
return t2
end func square
func clamp_score:
param score
t3 = score > 100
ifFalse t3 goto else1
return 100
goto endif2
else1:
t4 = score < 0
ifFalse t4 goto else3
return 0
goto endif4
else3:
return score
endif4:
endif2:
end func clamp_score
func is_passing:
param score
t5 = score >= 70
t6 = score <= 100
t7 = t5 && t6
return t7
end func is_passing
func bonus_by_level:
param level
bonus = 0
t8 = level == 1
if t8 goto case7
t9 = level == 2
if t9 goto case8
t10 = level == 3
if t10 goto case9
goto default6
case7:
bonus = 5
goto endswitch5
case8:
bonus = 10
goto endswitch5
case9:
bonus = 20
goto endswitch5
default6:
bonus = 1
goto endswitch5
endswitch5:
return bonus
end func bonus_by_level
func main:
arg 30
arg 40
t11 = call sum, 2
base = t11
arg 3
t12 = call square, 1
power = t12
level = 3
arg level
t13 = call bonus_by_level, 1
bonus = t13
scores[0] = 65
scores[1] = 72
scores[2] = 88
scores[3] = 91
t14 = scores[0]
t15 = t14 + bonus
matrix[0][0] = t15
t16 = scores[1]
t17 = t16 + bonus
matrix[0][1] = t17
t18 = scores[2]
t19 = t18 + bonus
matrix[1][0] = t19
t20 = scores[3]
t21 = t20 + bonus
matrix[1][1] = t21
total = 0
i = 0
for10:
t22 = i < 4
ifFalse t22 goto endfor12
t23 = i == 1
ifFalse t23 goto endif13
goto for_update11
endif13:
t24 = scores[i]
t25 = total + t24
total = t25
for_update11:
i = i + 1
goto for10
endfor12:
row = 0
matrix_total = 0
while14:
t26 = row < 2
ifFalse t26 goto endwhile15
col = 0
while16:
t27 = col < 2
ifFalse t27 goto endwhile17
t28 = matrix[row][col]
t29 = matrix_total + t28
matrix_total = t29
t30 = col + 1
col = t30
goto while16
endwhile17:
t31 = row + 1
row = t31
goto while14
endwhile15:
t32 = base + power
t33 = t32 + bonus
raw_score = t33
arg raw_score
t34 = call clamp_score, 1
final_score = t34
arg final_score
t35 = call is_passing, 1
passed = t35
printf 'base=%d power=%d bonus=%d', base, power, bonus
printf 'raw=%d final=%d', raw_score, final_score
printf 'array_total=%d matrix_total=%d', total, matrix_total
ifFalse passed goto else18
printf 'status=%s', 'PASSED'
goto endif19
else18:
printf 'status=%s', 'FAILED'
endif19:
print final_score
return final_score
end func main
